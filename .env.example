# ==============================================================================
# Home Assistant
# ==============================================================================
HA_IP=192.168.1.30
HA_PORT=8123
HA_SCHEME=http
HA_TOKEN=REPLACE_WITH_LONG_LIVED_ACCESS_TOKEN

# ==============================================================================
# Huawei ONT (SSH access to the management CLI)
# ==============================================================================
ONT_HOST=192.168.1.1
ONT_USER=root
ONT_PASS=adminHW

# ==============================================================================
# Exporter
# ==============================================================================
# WAN interface to read counters from (run `display bbsp stats wan` on the
# ONT to list them; wan1 is the one that carries the actual traffic)
WAN_INTERFACE=wan1

# Seconds between polling cycles (loop mode only)
INTERVAL=60

# Per-frame wire overhead deduction
#   - VLAN tagging on the WAN service is used by most ISPs -> true
#   - PPPoE only if your ISP provisions the connection with PPPoE
VLAN_ENABLED=true
PPPOE_ENABLED=false

# Read and log stats but do NOT push anything to Home Assistant (testing)
DRY_RUN=false

# Max backoff (seconds) after repeated failures; the loop doubles the wait
# after each consecutive failure, up to this cap
MAX_BACKOFF=3600

# ==============================================================================
# Advanced (the defaults are fine for most setups)
# ==============================================================================
# Re-send the ONT command until stats come back (input is sometimes dropped)
# COMMAND_ATTEMPTS=3
# Max seconds to wait for the WAP> prompt / command output
# PROMPT_TIMEOUT=15
# OUTPUT_TIMEOUT=20
# Auto-remove a stale SSH session when the ONT's one-session limit is hit
# AUTO_KILL_SESSIONS=true
# Seconds to wait after `quit` for the ONT to close the session before the
# connection is force-terminated (keeps the single session slot free)
# CLOSE_GRACE=3
